# Salin jadi .env.local untuk development. Jangan isi nilai asli di file ini (ikut ter-commit).

# Domain asli website, tanpa garis miring di akhir.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Supabase di VPS lewat tunnel: ssh -N -L 54321:127.0.0.1:8100 ghani-main
# SUPABASE_URL dipakai server (alamat internal), NEXT_PUBLIC_SUPABASE_URL dipakai browser untuk login.
SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi-anon-key
# Hanya di server; dipakai untuk mendaftarkan email admin. Jangan pernah diberi awalan NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=isi-service-role-key
